<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bee Điện Lạnh</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- HEADER -->
    <header>

        <div class="bee-topbar">
            <div class="container">

                <div class="row align-items-center py-3">

                    <!-- LOGO -->
                    <div class="col-lg-3">

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="bee-logo">

                            🐝 BEE ĐIỆN LẠNH

                        </a>

                    </div>


                    <!-- SEARCH -->
                    <div class="col-lg-5">

                        <form class="bee-search"
                              asp-area=""
                              asp-controller="Products"
                              asp-action="Index"
                              method="get">

                            <input type="text"
                                   name="search"
                                   placeholder="Bạn muốn tìm sản phẩm gì?" />

                            <button type="submit">
                                <i class="bi bi-search"></i>
                            </button>

                        </form>

                    </div>


                    <!-- ACCOUNT -->
                    <div class="col-lg-4 text-end">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            <!-- TÀI KHOẢN ĐÃ ĐĂNG NHẬP -->
                            <span class="bee-header-link">

                                <i class="bi bi-person-check"></i>

                                @User.Identity.Name

                            </span>


                            <!-- NẾU LÀ ADMIN -->
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Index"
                                   class="bee-header-link">

                                    <i class="bi bi-gear"></i>
                                    Quản lý

                                </a>
                            }


                            <!-- NẾU LÀ CUSTOMER -->
                            @if (User.IsInRole("Customer"))
                            {
                                <a asp-area=""
                                   asp-controller="Cart"
                                   asp-action="Index"
                                   class="bee-cart">

                                    <i class="bi bi-cart3"></i>
                                    Giỏ hàng

                                </a>
                            }


                            <!-- ĐĂNG XUẤT -->
                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="/"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="bee-header-link border-0 bg-transparent">

                                    Đăng xuất

                                </button>

                            </form>
                        }
                        else
                        {
                            <!-- CHƯA ĐĂNG NHẬP -->
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               class="bee-header-link">

                                <i class="bi bi-person"></i>
                                Đăng nhập

                            </a>

                            <a asp-area="Identity"
                               asp-page="/Account/Register"
                               class="bee-header-link">

                                Đăng ký

                            </a>


                            <!-- GIỎ HÀNG KHI CHƯA LOGIN -->
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="/Cart"
                               class="bee-cart">

                                <i class="bi bi-cart3"></i>
                                Giỏ hàng

                            </a>
                        }

                    </div>

                </div>

            </div>
        </div>


        <!-- MENU -->
        <nav class="bee-navbar">

            <div class="container">

                @await Component.InvokeAsync("CategoryMenu")

            </div>

        </nav>

    </header>


    <!-- NỘI DUNG THAY ĐỔI -->
    <main>

        @RenderBody()

    </main>


    <!-- FOOTER -->
    <footer class="bee-footer">

        <div class="container">

            <div class="row">

                <div class="col-md-4">

                    <h4>
                        🐝 BEE ĐIỆN LẠNH
                    </h4>

                    <p>
                        Chuyên cung cấp thiết bị điện tử,
                        điện lạnh chính hãng.
                    </p>

                </div>


                <div class="col-md-4">

                    <h5>
                        Hỗ trợ khách hàng
                    </h5>

                    <p>
                        Chính sách bảo hành
                    </p>

                    <p>
                        Chính sách đổi trả
                    </p>

                    <p>
                        Hướng dẫn mua hàng
                    </p>

                </div>


                <div class="col-md-4">

                    <h5>
                        Liên hệ
                    </h5>

                    <p>
                        <i class="bi bi-telephone"></i>
                        Hotline: 1900 0000
                    </p>

                    <p>
                        <i class="bi bi-envelope"></i>
                        support@beedienlanh.vn
                    </p>

                </div>

            </div>


            <hr />


            <div class="text-center">

                © 2026 Bee Điện Lạnh

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>